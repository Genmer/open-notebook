-- 迁移 32：命令表时间戳与状态索引（进度管理任务中心的基础）。
-- surreal-commands 的裸 CREATE 不写时间戳，这里用 schema 级默认值补齐：
-- created 在创建时生成，updated 在每次更新时刷新（任务中心按时间倒序展示）。
-- 旧行的 created 保持 NONE，排序时自然沉底。
DEFINE FIELD created ON command DEFAULT time::now();
DEFINE FIELD updated ON command VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_command_status ON command FIELDS status;
