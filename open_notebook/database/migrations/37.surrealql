-- Strict object fields silently drop free-form dict writes on SurrealDB
-- v2.6.5 (draft_content, verified_snapshot etc. were persisted as {}).
-- FLEXIBLE OBJECT accepts arbitrary keys; same fix as migration 36 did for
-- the bare option<array> keywords field.
REMOVE FIELD draft_content ON TABLE project_env;
DEFINE FIELD draft_content ON TABLE project_env FLEXIBLE TYPE option<object>;
REMOVE FIELD verified_snapshot ON TABLE project_env;
DEFINE FIELD verified_snapshot ON TABLE project_env FLEXIBLE TYPE option<object>;
REMOVE FIELD time_adjusted ON TABLE project_env;
DEFINE FIELD time_adjusted ON TABLE project_env FLEXIBLE TYPE option<object>;
REMOVE FIELD ai_assisted ON TABLE project_env;
DEFINE FIELD ai_assisted ON TABLE project_env FLEXIBLE TYPE option<object>;
REMOVE FIELD pending_claims ON TABLE project_env;
DEFINE FIELD pending_claims ON TABLE project_env FLEXIBLE TYPE option<array<object>>;
REMOVE FIELD verification_progress ON TABLE project_env;
DEFINE FIELD verification_progress ON TABLE project_env FLEXIBLE TYPE option<object>;
